{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "{env:LM_API_TOKEN}"
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "Qwen 3.5 9B (LM Studio)",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B QAT (LM Studio), unit 11"
        }
      }
    }
  },
  "model": "lmstudio/qwen/qwen3.5-9b",
  "share": "disabled",
  "disabled_providers": [
    "opencode"
  ],
  "default_agent": "ops",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "create_ticket": "ask",
    "skill": "ask",
    "runbooks_write_file": "deny",
    "runbooks_edit_file": "deny",
    "runbooks_move_file": "deny",
    "runbooks_create_directory": "deny",
    "rag_chroma_create_collection": "deny",
    "rag_chroma_modify_collection": "deny",
    "rag_chroma_fork_collection": "deny",
    "rag_chroma_delete_collection": "deny",
    "rag_chroma_add_documents": "deny",
    "rag_chroma_update_documents": "deny",
    "rag_chroma_delete_documents": "deny",
    "vault_write_file": "ask",
    "vault_edit_file": "ask",
    "vault_create_directory": "ask",
    "vault_move_file": "ask",
    "vault_append_file": "ask",
    "vault_copy_file": "ask"
  },
  "mcp": {
    "servers": {
      "runbooks": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem@2.2.0",
          "--read-only",
          "--confine-roots",
          "./runbooks"
        ],
        "codemode": false
      },
      "rag": {
        "type": "local",
        "command": [
          "uvx",
          "--python",
          "3.12",
          "--with",
          "pydantic<2.12",
          "chroma-mcp",
          "--client-type",
          "persistent",
          "--data-dir",
          "./rag/chroma_db"
        ],
        "codemode": false
      },
      "vault": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem@2.2.0",
          "--confine-roots",
          "../ops-vault"
        ],
        "codemode": false,
        "disabled": true
      }
    }
  },
  "compaction": {
    "buffer": 4000
  }
}
